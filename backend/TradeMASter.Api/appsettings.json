{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TradeMASterDb": "Host=localhost;Port=5432;Database=trademaster;Username=postgres;Password=postgres",
    "TradeMASterSqlite": "Data Source=trademaster.db",
    "Redis": "localhost:6379"
  },
  "Database": {
    "UsePostgreSql": false
  },
  "Cache": {
    "UseRedis": false
  },
  "MarketData": {
    "DefaultProvider": "YahooFinance",
    "EnableLiveSimulationFallback": true
  },
  "Robinhood": {
    "McpServerUrl": "https://agent.robinhood.com/mcp/trading",
    "OAuthAuthorizationUrl": "https://robinhood.com/oauth",
    "OAuthTokenUrl": "https://api.robinhood.com/oauth2/token/",
    "OAuthRegistrationUrl": "https://agent.robinhood.com/oauth/trading/register",
    "OAuthScope": "internal",
    "OAuthClientId": "",
    "RequestTimeoutSeconds": 30,
    "LiveTradingEnabled": false
  },
  "OpenAI": {
    "Model": "gpt-5.6-terra",
    "EnableWebSearch": true
  },
  "Sec": {
    "UserAgent": "TradeMASter/1.0 trademaster-local@localhost"
  },
  "Agents": {
    "AllowSimulatedLlm": true
  },
  "TradePlans": {
    "SecondaryConfirmationNotionalAmount": 100
  }
}
