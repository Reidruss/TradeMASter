{
  "version": "0.2.0",
  "configurations": [
    {
      "name": ".NET Core Launch (API Backend)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-backend",
      "program": "${workspaceFolder}/backend/DotnetSvelte.Api/bin/Debug/net10.0/DotnetSvelte.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/backend/DotnetSvelte.Api",
      "stopAtEntry": false,
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      },
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "sourceFileMap": {
        "/Views": "${workspaceFolder}/Views"
      }
    },
    {
      "name": "Launch Frontend (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    }
  ],
  "compounds": [
    {
      "name": "Full Stack (Backend + Frontend)",
      "configurations": [".NET Core Launch (API Backend)", "Launch Frontend (Chrome)"]
    }
  ]
}
